# Optional local settings. The prototype needs no third-party accounts or keys.
# true: simulated login with any credentials and a founder/mentor selector.
# false: local signup/password sign-in.
SYNERGY_DEMO_MODE=true
# Require moderator-verified affiliation for introductions; previews are exempt.
SYNERGY_REQUIRE_VERIFICATION=false
# Comma-separated local account emails allowed to moderate.
SYNERGY_ADMIN_EMAILS=
SYNERGY_DATA_FILE=.data/synergy.sqlite
# Comma-separated extra origins allowed to POST, for a frontend hosted elsewhere
# that proxies /api here (e.g. https://synergy-prototype.netlify.app).
SYNERGY_ALLOWED_ORIGINS=
# HOST=127.0.0.1
# PORT=4173

# Optional: a mounted/synchronized folder outside the data directory.
# SYNERGY_BACKUP_DIR=C:/Backups/Synergy
SYNERGY_BACKUP_INTERVAL_HOURS=24

# Optional transactional mentorship email. Demo mode uses the stub.
EMAIL_PROVIDER=stub
BREVO_API_KEY=
EMAIL_FROM=
BREVO_WEBHOOK_SECRET=
SYNERGY_PUBLIC_URL=

# v1.1 checkout simulation and signed payment callbacks.
PAYMENTS_PROVIDER=simulated
PAYMENTS_WEBHOOK_SECRET=
